#include <winver.h>
#include "version.h"

1 ICON "puren_tonbo_red_icon_32x32.ico"

1 VERSIONINFO
FILEVERSION     TONBO_VERSION_MAJOR, TONBO_VERSION_MINOR, TONBO_VERSION_PATCH, 0
PRODUCTVERSION  TONBO_VERSION_MAJOR, TONBO_VERSION_MINOR, TONBO_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  TONBO_FILE_DESCRIPTION
      VALUE "FileVersion",      TONBO_VERSION_STRING
      VALUE "ProductName",      TONBO_PRODUCT_NAME
      VALUE "ProductVersion",   TONBO_VERSION_STRING
      VALUE "LegalCopyright",   TONBO_COPYRIGHT
      VALUE "OriginalFilename", TONBO_ORIGINAL_FILENAME
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04b0  /* US English, Unicode */
  END
END
